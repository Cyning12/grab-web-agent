SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V4-Flash
EMBEDDING_MODEL=BAAI/bge-m3
FASTAPI_PORT=8000
FLASK_PORT=5000
COMPANY_DIR=./company
TASK_TARGET_URLS=https://gu.qq.com/sz000858/gp,https://gu.qq.com/sz300810/gp

# ===== 对内子图可选调参（有默认值兜底 · 30 合并时补录）=====
RAG_TOP_K=5                    # Top-K 检索条数
RAG_TOP_K_DEGRADED=2           # 资源降级时截断 Top-K（铁律三唯一降级手段）
RAG_RSS_PEAK_LIMIT_MB=3072     # A7 钉死值：RSS 峰值上限
RAG_RSS_DEGRADE_MB=2560        # 逼近阈值即触发降级的采样水位
# RAG_LIVE_SMOKE=1             # 默认关；置 1 才跑真实 SiliconFlow 冒烟

# ===== 抓取截图触发延迟（task_screenshot_delay）=====
SCREENSHOT_DELAY_MS=5000       # 渲染探针通过后、截图留痕前的页面/蒙层稳定等待毫秒数（推荐 3000-5000；非数字/负数落默认 5000 并记 warning；anti_bot 路径不延迟空等）
